# Copy to .env and fill in. Never commit .env.
PORT=3001
CONTACT_TO=ayushgokhle@gmail.com

# SMTP (Gmail example: smtp.gmail.com, port 465, and an App Password — not your real password:
# https://myaccount.google.com/apppasswords). Leave blank to just save messages to server/messages.jsonl.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Only needed when the site and API are on different domains, e.g. https://yourname.com
ALLOWED_ORIGIN=
